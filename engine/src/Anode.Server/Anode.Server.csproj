<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>REST and WebSocket API for Anode: projects, edits, library and media; drives the engine host over IPC.</Description>
    <AssemblyName>anode-server</AssemblyName>
    <RootNamespace>Anode.Server</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Anode.Contracts/Anode.Contracts.csproj"/>
    <!-- Phase 8: the control protocols (workstream D) and stem separation (E, which brings ONNX Runtime; the host does
         not reference it). -->
    <ProjectReference Include="../Anode.Control/Anode.Control.csproj"/>
    <ProjectReference Include="../Anode.Stems/Anode.Stems.csproj"/>
    <!-- Phase 9: the notation engine (workstream A) and interchange (D, E; B's SMF mapping). The host references
         neither. -->
    <ProjectReference Include="../Anode.Notation/Anode.Notation.csproj"/>
    <ProjectReference Include="../Anode.Interchange/Anode.Interchange.csproj"/>
    <!-- The built-in instruments' descriptors: the catalogue edits use before a host has sent one, and FakeHost's. -->
    <ProjectReference Include="../Anode.Dsp/Anode.Dsp.csproj"/>
    <ProjectReference Include="../Anode.Ipc/Anode.Ipc.csproj"/>
    <ProjectReference Include="../Anode.EngineHost/Anode.EngineHost.csproj"/>
    <ProjectReference Include="../Anode.Model/Anode.Model.csproj"/>
  </ItemGroup>
</Project>
