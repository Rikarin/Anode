{
  "openapi": "3.1.1",
  "info": {
    "title": "anode-server | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/api/v1/system": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "The server\u0027s version and its link to the engine host.",
        "operationId": "GetSystem",
        "responses": {
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EngineState": {
        "enum": [
          "disconnected",
          "connected",
          "inprocess"
        ]
      },
      "EngineStatus": {
        "required": [
          "state"
        ],
        "type": "object",
        "properties": {
          "state": {
            "$ref": "#/components/schemas/EngineState"
          },
          "hostVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "backend": {
            "type": [
              "null",
              "string"
            ]
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "The server\u0027s link to the engine host: whether it is reachable (\u0060state\u0060), the host\u0027s version and audio\nbackend (\u0060coreaudio\u0060, \u0060wasapi\u0060, \u0060alsa\u0060, \u0060null\u0060) from its hello while connected, and why the\nlink is down when it is (\u0060message\u0060)."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SystemInfo": {
        "required": [
          "version",
          "engine"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/EngineStatus"
          }
        },
        "description": "What \u0060GET /api/v1/system\u0060 answers: the server\u0027s version and its link to the engine host."
      }
    }
  },
  "tags": [
    {
      "name": "System"
    }
  ]
}
