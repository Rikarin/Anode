<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>anode-host</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Real-time host: workstation, non-concurrent GC with a large gen0 budget (docs/adr/0001-process-model.md). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Anode.EngineHost/Anode.EngineHost.csproj"/>
    <!-- Built beside it, not referenced: the plugin sandbox and scanner processes it starts. -->
    <ProjectReference Include="../Anode.PluginSandbox/Anode.PluginSandbox.csproj" ReferenceOutputAssembly="false"
                      Private="false"/>
  </ItemGroup>
  <!-- The sandbox's build beside anode-host's, where PluginHost looks for it (a published app ships the NativeAOT
       anode-plugin beside the NativeAOT anode-host instead). -->
  <Target Name="CopyPluginSandbox" AfterTargets="Build">
    <ItemGroup>
      <PluginSandboxFiles Include="$(MSBuildThisFileDirectory)../Anode.PluginSandbox/bin/$(Configuration)/$(TargetFramework)/anode-plugin*"/>
    </ItemGroup>
    <Copy SourceFiles="@(PluginSandboxFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true"/>
  </Target>
</Project>
