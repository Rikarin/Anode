// Rock drums written for Anode: straight eighths on the hi-hat, kick and snare on the beats, toms and snare in the fills.
// Lanes are one character per sixteenth (X accent, x normal, o soft, g ghost: kept by complexity, . rest); | marks beats.
{
  "format": 1,
  "id": "drums-rock",
  "name": "Rock, Straight Eights",
  "player": "drummer",
  "genre": "Rock",
  "description": "A straight rock beat: eighth-note hi-hat, a solid backbeat, the ride in loud choruses and tom fills into each section.",
  "kitPatchId": "kit_drummer_acoustic",
  "humanise": { "timingTicks": 10, "velocity": 6 },
  "timekeeper": "ride",
  "defaults": { "complexity": 0.45, "intensity": 0.5, "fillAmount": 0.4, "fillAtSectionEnds": true, "swing": 0, "feel": 0 },
  "presets": [
    { "id": "straight", "name": "Straight", "parameters": {} },
    { "id": "driving", "name": "Driving", "parameters": { "complexity": 0.7, "intensity": 0.8, "fillAmount": 0.6, "feel": 0.2 } },
    { "id": "laid-back", "name": "Laid Back", "parameters": { "complexity": 0.3, "intensity": 0.35, "fillAmount": 0.25, "feel": -0.4 } },
    { "id": "sparse", "name": "Sparse", "parameters": { "complexity": 0.1, "intensity": 0.4, "fillAmount": 0.1, "pieces": { "toms": { "on": false } } } }
  ],
  "sections": {
    "intro": { "complexity": 0.3, "intensity": 0.35 },
    "verse": { "complexity": 0.45, "intensity": 0.45 },
    "chorus": { "complexity": 0.6, "intensity": 0.7 },
    "bridge": { "complexity": 0.4, "intensity": 0.5 },
    "outro": { "complexity": 0.4, "intensity": 0.55 }
  },
  "grammar": {
    "intro": { "form": "A", "complexity": -0.15, "intensity": -0.15, "first": "intro", "last": "pickup" },
    "verse": { "form": "AAAB", "substitutions": ["openHat", "ghostNotes"] },
    "chorus": { "form": "ABAB", "complexity": 0.1, "intensity": 0.2, "substitutions": ["crashOnOne", "rideForHat", "openHat"] },
    "bridge": { "form": "AB", "intensity": -0.05, "substitutions": ["halfTime", "crashOnOne"] },
    "outro": { "form": "AAAB", "intensity": -0.05, "last": "ending", "substitutions": ["crashOnOne"] }
  },
  "variations": {
    "hiHat": ["xoxo|xoxo|xoxo|xoxo", "x...|x...|x...|x...", "..x.|..x.|..x.|..x."],
    "kick": ["x...|x...|x...|x...", "x...|....|x.x.|...."],
    "snare": ["....|x...|....|x..x", "....|x..x|....|x..."]
  },
