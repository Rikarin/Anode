// Pop drums written for Anode: a tight kick and snare, shaker and tambourine layers, claps doubling the backbeat.
{
  "format": 1,
  "id": "drums-pop",
  "name": "Pop, Modern Groove",
  "player": "drummer",
  "genre": "Pop",
  "description": "A modern pop groove: a syncopated kick, claps on the backbeat, shaker and tambourine layers that build into the chorus.",
  "kitPatchId": "kit_drummer_acoustic",
  "humanise": { "timingTicks": 6, "velocity": 5 },
  "timekeeper": "ride",
  "defaults": { "complexity": 0.45, "intensity": 0.5, "fillAmount": 0.3, "fillAtSectionEnds": true, "swing": 0, "feel": 0 },
  "presets": [
    { "id": "radio", "name": "Radio", "parameters": {} },
    { "id": "big-chorus", "name": "Big Chorus", "parameters": { "complexity": 0.65, "intensity": 0.9, "fillAmount": 0.5 } },
    { "id": "intimate", "name": "Intimate", "parameters": { "complexity": 0.2, "intensity": 0.1, "fillAmount": 0.15, "pieces": { "cymbals": { "on": false } } } }
  ],
