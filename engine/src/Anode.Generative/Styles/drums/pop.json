    "bridge": { "form": "AAAB", "complexity": -0.1, "substitutions": ["halfTime", "crashOnOne"] },
    "outro": { "form": "A", "last": "ending", "substitutions": ["crashOnOne"] }
  },
  "variations": {
    "hiHat": ["xoxo|xoxo|xoxo|xoxo", "..x.|..x.|..x.|..x."],
