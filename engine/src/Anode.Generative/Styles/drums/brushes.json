// Brushes written for Anode: a triplet-feel ballad, the snare swept in triplets with the backbeat tapped, the pedal hat
// on two and four, the ride's swung pattern higher on the pad. Lanes are one character per triplet eighth (12 a bar).
{
  "format": 1,
  "id": "drums-brushes",
  "name": "Ballad, Brushes",
  "player": "drummer",
  "genre": "Jazz",
  "description": "A brushed ballad in a triplet feel: swept snare, the pedal hi-hat on two and four, a swung ride and soft tom fills.",
  "kitPatchId": "kit_drummer_brushes",
  "stepsPerBar": 12,
  "humanise": { "timingTicks": 12, "velocity": 8 },
  "timekeeper": "ride",
  "defaults": { "complexity": 0.4, "intensity": 0.4, "fillAmount": 0.25, "fillAtSectionEnds": true, "swing": 0, "feel": -0.15 },
  "presets": [
    { "id": "late-night", "name": "Late Night", "parameters": {} },
    { "id": "swinging", "name": "Swinging", "parameters": { "complexity": 0.75, "intensity": 0.6, "fillAmount": 0.4 } },
    { "id": "whisper", "name": "Whisper", "parameters": { "complexity": 0.15, "intensity": 0.1, "fillAmount": 0.1 } }
  ],
