// Rock bass written for Anode. A token per sixteenth: R the root (the slash bass under a slash chord), r the root
// itself, 3 5 7 the chord's third, fifth and seventh, 8 the octave, 2 4 6 scale steps above the root, A a half step
// into the next chord, X a dead note; ' up and , down an octave; ! accent, ? soft; - holds, . rests; | marks beats.
{
  "format": 1,
  "id": "bass-rock",
  "name": "Rock, Driving Eighths",
  "player": "bass",
  "genre": "Rock",
  "description": "A driving rock bass: roots in eighths locked to the kick, fifths and octaves higher on the pad, walk-ups into each section.",
  "humanise": { "timingTicks": 8, "velocity": 6 },
  "defaults": {
    "complexity": 0.45, "intensity": 0.55, "fillAmount": 0.35, "fillAtSectionEnds": true, "swing": 0, "feel": 0, "followChords": true,
    "bass": { "lowNote": 28, "highNote": 60, "slides": false, "deadNotes": false }
  },
  "presets": [
    { "id": "eighths", "name": "Eighths", "parameters": {} },
    { "id": "roots", "name": "Roots", "parameters": { "complexity": 0.15, "intensity": 0.45, "fillAmount": 0.1 } },
    { "id": "pumping", "name": "Pumping", "parameters": { "complexity": 0.7, "intensity": 0.85, "bass": { "slides": true } } }
  ],
  "sections": {
    "intro": { "complexity": 0.25, "intensity": 0.4 },
    "verse": { "complexity": 0.45, "intensity": 0.5 },
    "chorus": { "complexity": 0.6, "intensity": 0.75 },
    "bridge": { "complexity": 0.4, "intensity": 0.5 },
    "outro": { "complexity": 0.4, "intensity": 0.55 }
  },
  "grammar": {
    "intro": { "form": "A", "complexity": -0.2, "intensity": -0.2 },
    "verse": { "form": "AAAB", "substitutions": ["approachNotes"] },
    "chorus": { "form": "AB", "complexity": 0.15, "intensity": 0.2, "substitutions": ["approachNotes", "octaveDoubling"] },
    "bridge": { "form": "AB", "substitutions": ["approachNotes"] },
    "outro": { "form": "AAAB", "last": "ending" }
  },
  "phrases": [
    { "id": "halves", "role": "groove", "complexity": 0.0, "intensity": 0.3, "lanes": { "bass": "R! - - - | - - - - | R - - - | - - - -" } },
    { "id": "halves-soft", "role": "groove", "complexity": 0.25, "intensity": 0.05, "lanes": { "bass": "R? - - - | - - . . | 5? - - - | - - . ." } },
    { "id": "quarters", "role": "groove", "complexity": 0.25, "intensity": 0.4, "lanes": { "bass": "R! - . . | R - . . | R - . . | R - . ." } },
    { "id": "eighths", "role": "groove", "complexity": 0.5, "intensity": 0.5, "lanes": { "bass": "R! . R . | R . R . | R . R . | R . R ." } },
    { "id": "eighths-fifths", "role": "groove", "complexity": 0.75, "intensity": 0.6, "lanes": { "bass": "R! . R . | R . R . | 5 . R . | 8 . R ." } },
    { "id": "eighths-loud", "role": "groove", "complexity": 0.75, "intensity": 0.95, "lanes": { "bass": "R! . R! . | R! . R! . | R! . R! . | 8! . R! ." } },
    { "id": "busy", "role": "groove", "complexity": 1.0, "intensity": 0.75, "lanes": { "bass": "R! . R R | . R R . | 5 . 5 R | 8 . A ." } },
    { "id": "two-bar", "role": "groove", "complexity": 0.6, "intensity": 0.55, "bars": 2, "lanes": { "bass": "R! . R . | R . R . | R . R . | 5 . 3 . | R! . R . | R . R . | 8 . 5 . | R . A ." } },
    { "id": "hold", "role": "ending", "complexity": 0.5, "intensity": 0.5, "lanes": { "bass": "R! - - - | - - - - | - - - - | - - - -" } },
    { "id": "walk-half", "role": "fill", "complexity": 0.3, "intensity": 0.5, "from": 8, "lanes": { "bass": ". . . . | . . . . | R . 3 . | 5 . A ." } },
    { "id": "walk-beat", "role": "fill", "complexity": 0.6, "intensity": 0.6, "from": 12, "lanes": { "bass": ". . . . | . . . . | . . . . | 5 3 2 A" } },
    { "id": "walk-bar", "role": "fill", "complexity": 0.8, "intensity": 0.7, "lanes": { "bass": "R . 5 . | 8 . 5 . | R . 3 . | 5 . A ." } }
  ]
}
