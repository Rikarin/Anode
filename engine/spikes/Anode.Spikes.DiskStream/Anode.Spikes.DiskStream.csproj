<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike S2 (docs/spikes/S2-disk-streaming.md): can a NativeAOT engine stream 128 mono 48 kHz / 24-bit tracks from
    disk at 64-frame buffers, cycle jump included, with no underruns and no allocation on the audio thread?
    Published NativeAOT with the host's GC settings (engine/src/Anode.Host/Anode.Host.csproj); run.sh adds the gen0
    budget the host runs with (DOTNET_GCgen0size).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Throwaway measurement code: keep it readable rather than analyzer-clean. -->
    <NoWarn>$(NoWarn);CA1031;CA1305;CA1515;CA1812;CA1852;CA2000;CA5394</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Anode.Audio/Anode.Audio.csproj"/>
  </ItemGroup>
</Project>
