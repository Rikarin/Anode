<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Spike S5 (docs/spikes/S5-time-stretch.md): is Signalsmith Stretch, through the an_stretch shim
    (engine/native/an_stretch), good and cheap enough for Flex Time, Flex Pitch, Varispeed and tempo-following loops?
    Renders test material for listening and measures CPU, latency and objective quality proxies. Run with run.sh.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAotCompatible>false</IsAotCompatible>
    <TieredPGO>true</TieredPGO>
    <!-- Throwaway measurement code: keep it readable rather than analyzer-clean. -->
    <NoWarn>$(NoWarn);CA1303;CA1305;CA1307;CA1310;CA1515;CA1812;CA1822;CA1852;CA1859;CA1861;CA2000;CA5394</NoWarn>
  </PropertyGroup>
</Project>
