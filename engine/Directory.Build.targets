<Project>
    <!--
      Copies the native shims built by native/build.sh (artifacts/native: cth_* and an_*) next to every executable
      and test project. When it hasn't been built, managed code reports the backend as unavailable instead of failing.
    -->
    <PropertyGroup>
        <AnodeNativeDir>$(MSBuildThisFileDirectory)artifacts/native/</AnodeNativeDir>
    </PropertyGroup>
    <ItemGroup Condition="'$(OutputType)' == 'Exe'">
        <None Include="$(AnodeNativeDir)*cth_*.*;$(AnodeNativeDir)*an_*.*"
              Exclude="$(AnodeNativeDir)*.exp;$(AnodeNativeDir)*.lib;$(AnodeNativeDir)*.pdb"
              Visible="false"
              CopyToOutputDirectory="PreserveNewest"
              CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>
</Project>
