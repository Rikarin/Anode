{
  "name": "timeline",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/timeline/src",
  "tags": ["type:ui"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc -p libs/timeline/tsconfig.lib.json --noEmit",
          "tsc -p libs/timeline/tsconfig.spec.json --noEmit",
          "tsc -p libs/timeline/tsconfig.bench.json --noEmit"
        ],
        "parallel": false
      }
    },
    "bench": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "vite --config libs/timeline/vite.bench.config.mts" }
    },
    "bench-run": {
      "executor": "nx:run-commands",
      "options": { "command": "node libs/timeline/bench/run-bench.mts" }
    }
  }
}
