# Skala (skala.jsonc, .github/workflows/skala.yml) reads its rule severities and thresholds from here, as Roslyn and the
# IDE do; skala.jsonc holds only the gates. A rule that fits this codebase is fixed to zero findings, and one that does
# not is switched off or re-tuned below, with the reason, instead of being parked in .skala/baseline.sarif. Every rule
# not named here runs at Skala's default. The rules below are inherited from Cathode, for the same reasons.
root = true

[*.cs]
# SK6034, a public constant is baked into every caller: the engine's assemblies are one application, built and shipped
# together from this solution (nothing is published as a library), so every caller is always rebuilt with the constant.
dotnet_diagnostic.SK6034.severity = none

# SK4002, review a delegate that captures an iteration-local: a prompt to review allocation, not a defect. It cannot
# tell the audio thread from the control thread; the audio path's allocation discipline is enforced by tests that
# measure it.
dotnet_diagnostic.SK4002.severity = none

# SK1084, use a LINQ operator for part of a loop: the opposite of this codebase's deliberate style. An explicit loop
# allocates nothing, and the engine, the compilers and the host keep LINQ off every path near the audio thread.
dotnet_diagnostic.SK1084.severity = none

# SK7005, a member takes more than 8 parameters: positional records are this codebase's form for wire contracts.
dotnet_diagnostic.SK7005.severity = none

# Tests and spikes: table-driven test methods, repeated ids and throwaway measurement harnesses are the readable choice
# there. The metrics and the repeated-literal rule stay on for the shipped code.
[engine/{tests,spikes}/**.cs]
dotnet_diagnostic.SK7001.severity = none
dotnet_diagnostic.SK7002.severity = none
dotnet_diagnostic.SK7003.severity = none
dotnet_diagnostic.SK7082.severity = none
dotnet_diagnostic.SK7083.severity = none

# The DSP library: a per-sample kernel is one routine per algorithm on purpose (the hot path stays inline and
# allocation-free, and it reads against the paper it implements).
[engine/src/Anode.Dsp/**.cs]
dotnet_diagnostic.SK7001.severity = none
dotnet_diagnostic.SK7002.severity = none
dotnet_diagnostic.SK7003.severity = none
dotnet_diagnostic.SK7030.severity = none

# Tests: a test class or a random-project generator names the contract types it drives, and the generator is one
# table of every edit. The ceilings stay, a little over today's largest, so a fixture nobody can hold in mind still
# shows up.
[engine/tests/**.cs]
dotnet_code_quality.SK7030.threshold = 2500
dotnet_code_quality.SK7081.threshold = 350

# The tools: a probe's main loop is one long flat menu of checks, and the content builder's repeated literals are the
# parameter names of the factory content it writes. Neither ships in the engine.
[engine/tools/**.cs]
dotnet_code_quality.SK7001.threshold = 40
dotnet_code_quality.SK7083.threshold = 60

# The dispatchers over the closed unions: EditCommand has some 180 cases, DeltaOp and IpcMessage about as many again,
# and anything that switches over one, names each case once or lists them for the JSON source generator is a flat
# table of them. Its branch and type counts are the size of the wire contract, not tangled logic (cognitive complexity,
# SK7002, stays at its default and passes), and splitting a table would only hide it. The bound checkers and parsers
# in the list read the same way: one flat guard or lookup after another. The ceilings stay over today's largest.
[engine/src/{Anode.Contracts/Commands,Anode.Contracts/ContractsJsonContext,Anode.Engine/EngineController,Anode.Engine/Environment/EnvironmentNodes,Anode.EngineHost/EngineHost,Anode.Interchange/MusicXml/MusicXmlVocabulary,Anode.Ipc/Segments/MappedSegment,Anode.Model/History/EditHistory,Anode.Model/ProjectState,Anode.Model/Storage/ProjectPackage,Anode.Model/Editing/Edits,Anode.Model/Editing/Edits.Environment,Anode.Model/Editing/Edits.Mixer,Anode.Model/Editing/Edits.Phase7,Anode.Model/Editing/Edits.Phase9,Anode.Server/Engine/EngineConnection,Anode.Server/Engine/FakeHost,Anode.Server/Engine/HostSync,Anode.Server/Projects/Jobs,Anode.Server/Projects/ProjectSession}.cs]
dotnet_code_quality.SK7001.threshold = 100
dotnet_code_quality.SK7081.threshold = 200

# File length: these are one closed thing each (the command union, the IPC messages, the package format and its
# migrations) or a partial class already split by subject, and the next cut would be arbitrary. SK7030's default of
# 1000 is its own "starting policy, not a measurement"; this is the measurement, with the ceiling just over the largest.
[engine/src/{Anode.Contracts/Commands,Anode.Engine/AudioEngine.Mix,Anode.Engine/AudioEngine.Spatial,Anode.Engine/EngineController,Anode.Ipc/IpcMessage,Anode.Model/Storage/ProjectPackage,Anode.Server/Engine/FakeHost,Anode.Server/Projects/ProjectSession}.cs]
dotnet_code_quality.SK7030.threshold = 1600
